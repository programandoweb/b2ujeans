APP_NAME=Gaspronal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gaspronal
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

JWT_SECRET=
JWT_TTL=120
JWT_REFRESH_TTL=20160

FRONTEND_URL=http://localhost:3000

DEPLOYMENT_ENABLED=false
DEPLOYMENT_SCRIPT=/var/www/gaspronal.programandoweb.net/scripts/deploy.sh
DEPLOYMENT_PHP_BINARY=php
DEPLOYMENT_TIMEOUT=1800
DEPLOYMENT_USE_SUDO=false
DEPLOYMENT_SUDO_COMMAND=/usr/local/bin/gaspronal-deploy

ADMIN_NAME=Administrador Gaspronal
ADMIN_EMAIL=
ADMIN_PASSWORD=
